// Prisma schema for design-ai-ops
// 数据库：SQLite（个人本地使用）

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============= 类目 =============
model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============= 周计划 =============
model Schedule {
  id          String   @id @default(cuid())
  dayOfWeek   Int      @unique // 1-7 表示周一到周日
  theme       String
  description String?
  tasks       Task[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============= 发布任务 =============
model Task {
  id          String    @id @default(cuid())
  scheduleId  String?
  schedule    Schedule? @relation(fields: [scheduleId], references: [id])
  platform    String    // xiaohongshu / xianyu
  publishTime String    // HH:mm
  category    String
  contentType String    // 案例/避坑/报价/流程/商品/包月/复盘
  title       String
  body        String?
  coverText   String?
  imageUrl    String?
  status      String    @default("pending") // pending/generated/published/recapped
  priority    Int       @default(0)
  posts       Post[]
  products    Product[]
  metrics     Metric[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ============= 小红书帖子 =============
model Post {
  id        String   @id @default(cuid())
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id])
  platform  String
  title     String
  body      String
  tags      String?
  coverText String?
  cta       String?
  status    String   @default("draft")
  metrics   Metric[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============= 闲鱼商品 =============
model Product {
  id            String   @id @default(cuid())
  taskId        String?
  task          Task?    @relation(fields: [taskId], references: [id])
  title         String
  description   String
  coverText     String?
  priceTier     String?  // 引流/标准/利润
  deliveryScope String?
  revisionRule  String?
  status        String   @default("draft")
  metrics       Metric[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ============= 素材 =============
model Asset {
  id        String   @id @default(cuid())
  type      String   // 封面图/商品首图/案例图/样机图/背景图...
  source    String   // ai_generated / manual_upload
  platform  String?
  category  String?
  url       String
  prompt    String?
  fileName  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============= 关键词库 =============
model Keyword {
  id        String   @id @default(cuid())
  category  String
  platform  String
  keyword   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============= 价格套餐 =============
model PricePackage {
  id          String   @id @default(cuid())
  category    String
  tier        String   // 引流款/标准款/利润款
  name        String
  priceRange  String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============= 私信话术 =============
model Script {
  id        String   @id @default(cuid())
  type      String
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============= 数据指标 =============
model Metric {
  id                String   @id @default(cuid())
  taskId            String?
  task              Task?    @relation(fields: [taskId], references: [id])
  postId            String?
  post              Post?    @relation(fields: [postId], references: [id])
  productId         String?
  product           Product? @relation(fields: [productId], references: [id])
  platform          String
  date              DateTime
  title             String?
  category          String?
  impressions       Int      @default(0)
  clicks            Int      @default(0)
  likes             Int      @default(0)
  favorites         Int      @default(0)
  comments          Int      @default(0)
  messages          Int      @default(0)
  views             Int      @default(0)
  consultations     Int      @default(0)
  orders            Int      @default(0)
  revenue           Float    @default(0)
  averageOrderValue Float    @default(0)
  subscriptionLeads Int      @default(0)
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ============= AI 输出历史 =============
model AIOutput {
  id        String   @id @default(cuid())
  type      String   // text/image/suggestion
  input     String
  output    String
  model     String?
  createdAt DateTime @default(now())
}

// ============= 设置 =============
model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


// ============= 客户档案 =============
model Client {
  id          String       @id @default(cuid())
  nickname    String       // 客户昵称（小红书或闲鱼ID）
  platform    String       // xiaohongshu / xianyu / other
  category    String?      // 偏好类目
  tags        String?      // 标签，逗号分隔
  status      String       @default("lead") // lead/negotiating/customer/lost
  totalOrders Int          @default(0)
  totalRevenue Float       @default(0)
  lastContact DateTime?    // 上次接触时间
  notes       ClientNote[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

// ============= 客户跟进记录 =============
model ClientNote {
  id         String   @id @default(cuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type       String   @default("note") // note/quote/order/feedback
  content    String
  amount     Float?   // 报价或成交金额
  createdAt  DateTime @default(now())
}

// ============= 图片样式预设 =============
model ImagePreset {
  id             String   @id @default(cuid())
  name           String
  styleKeywords  String   // 正向风格关键词
  negativePrompt String?  // 负向词
  size           String   @default("1024x1536")
  imageType      String   @default("封面图")
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ============= API Key 池（v0.11 B1 唯一 schema 改） =============
//
// 用户原话「不考虑安全性」→ 明文存 SQLite，不加密、不轮换。
// provider 取 'llm' / 'image'，未来扩展可加 'embedding' / 'rerank' / ...
//
// 选 key 逻辑（src/lib/ai/keys.ts）：
//   SELECT WHERE provider=? AND active=true ORDER BY priority ASC, createdAt ASC LIMIT 1
//
// 失败自动 disable：consecutiveErrors >= 3 → active=false
// 成功自动 reset：    consecutiveErrors=0, lastUsedAt=now
//
// 数据迁移（v0.11 B1）：首次启动若 ApiKey 为空且 Setting 有 LLM_API_KEY/IMAGE_API_KEY →
// 自动 seed 一条（src/lib/seed-api-keys.ts，惰性触发，模块缓存）
model ApiKey {
  id                String    @id @default(cuid())
  provider          String    // 'llm' | 'image'
  label             String    // 用户起的名字，例 "DeepSeek 主用"
  baseUrl           String    // https://inference.do-ai.run/v1
  apiKey            String    // 明文（用户 said 不考虑安全）
  model             String    // deepseek-v4-pro / gpt-image-2 / ...
  active            Boolean   @default(true)
  priority          Int       @default(0)  // 越小越优先
  lastUsedAt        DateTime?
  lastError         String?   // 最近一次失败原因
  consecutiveErrors Int       @default(0)
  totalRequests     Int       @default(0)
  totalErrors       Int       @default(0)
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([provider, active, priority])
}


// ============= v0.18-AUTH 用户账户 =============
// 单租户工作台：所有业务数据归属管理员 admin。注册账户能登录查看，
// 但 workspace 共享 admin 的同一份数据。
model User {
  id        String   @id @default(cuid())
  username  String   @unique
  passHash  String
  role      String   @default("user") // admin / user
  active    Boolean  @default(true)
  lastLogin DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


// ============= v0.18-DISCUSS 讨论工具（平台原生聊天室） =============
// 单一公共讨论频道。发送者 = 平台登录用户名（不另设昵称）。
// 自增 Int id 便于前端按 afterId 做增量轮询。
model DiscussMessage {
  id        Int      @id @default(autoincrement())
  username  String
  role      String   @default("user")
  content   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}
