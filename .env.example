# ============================================
# 平面设计接单 AI 运营工作台 - 环境变量示例
# 复制本文件为 .env 后填写
# ============================================

# --- 数据库 ---
# 默认使用 SQLite，文件保存在 prisma/dev.db
DATABASE_URL="file:./dev.db"

# --- LLM 文案 API（兼容 OpenAI Chat Completions 格式） ---
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- 图片生成 API（兼容 GPT IMG 2） ---
IMAGE_API_BASE_URL=https://api.openai.com/v1
IMAGE_API_KEY=
IMAGE_MODEL=gpt-img-2
