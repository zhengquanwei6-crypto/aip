'use client';

/**
 * <PlatformWorkspaceClient>
 * 三个平台运营 agent 共用的极简工作区：
 *   - 一个大输入框
 *   - 一键"生成"按钮
 *   - 出来后展示：文案块 + 图片块 + 操作按钮
 */

import { useState } from 'react';
import { Loader2, Copy, Download, RefreshCw } from 'lucide-react';

export interface PlatformWorkspaceProps {
  slug: 'xiaohongshu-operator' | 'xianyu-operator' | 'qianniu-operator';
  title: string;        // 显示的页面标题
  icon: string;         // emoji
  placeholder: string;  // 输入框 placeholder
  expectSize: string;   // 期望输出尺寸描述（"1080×1440 竖图"）
}

interface BuildResponse {
  ok: boolean;
  text?: {
    title?: string;
    body?: string;
    tags?: string[];
    styleSummary?: string;
    priceTag?: string;
    sellingPoint?: string;
    sellingPoints?: string[];
    mainSellingPoint?: string;
  };
  image?: {
    url: string;
    rawUrl?: string;
    cropInfo?: { from?: string; to?: string; bytes?: number; error?: string };
    upstreamSize?: string;
    platformSize?: string;
    assetId?: string;
  };
  timing?: { llmMs: number; imgMs: number; cropMs: number; totalMs: number };
  error?: string;
  stage?: string;
  model?: string;
}

export function PlatformWorkspaceClient(props: PlatformWorkspaceProps) {
  const [topic, setTopic] = useState('');
  const [loading, setLoading] = useState(false);
  const [stage, setStage] = useState<string>('');
  const [result, setResult] = useState<BuildResponse | null>(null);
  const [error, setError] = useState<string | null>(null);

  async function generate() {
    const t = topic.trim();
    if (!t) return;
    setLoading(true);
    setStage('正在写文案...');
    setResult(null);
    setError(null);

    // 起一个 timer 大致提示阶段
    const timer = setTimeout(() => setStage('正在生成主图...'), 15000);
    const timer2 = setTimeout(() => setStage('正在裁剪到平台规范...'), 60000);

    try {
      const r = await fetch(`/api/agents/${props.slug}/build-all`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ topic: t }),
      });
      const j = (await r.json()) as BuildResponse;
      clearTimeout(timer); clearTimeout(timer2);
      if (!j.ok) {
        setError(`${j.stage ? `[${j.stage}] ` : ''}${j.error || '生成失败'}`);
        setResult(j); // 让用户至少能看到 LLM 部分
      } else {
        setResult(j);
      }
    } catch (e) {
      clearTimeout(timer); clearTimeout(timer2);
      setError((e as Error).message);
    } finally {
      setLoading(false);
      setStage('');
    }
  }

  function copyAllText() {
    const t = result?.text;
    if (!t) return;
    const lines: string[] = [];
    if (t.title) lines.push(`【标题】\n${t.title}`);
    if (t.body) lines.push(`\n【正文】\n${t.body}`);
    if (Array.isArray(t.tags) && t.tags.length > 0) lines.push(`\n【标签】\n${t.tags.map((x) => `#${x}`).join(' ')}`);
    if (Array.isArray(t.sellingPoints) && t.sellingPoints.length > 0) lines.push(`\n【卖点】\n${t.sellingPoints.map((x) => `· ${x}`).join('\n')}`);
    if (t.priceTag) lines.push(`\n【价位】${t.priceTag}`);
    void navigator.clipboard.writeText(lines.join('\n')).then(
      () => alert('已复制全部文案'),
      () => alert('复制失败'),
    );
  }

  function downloadImage() {
    const url = result?.image?.url;
    if (!url) return;
    const a = document.createElement('a');
    a.href = url;
    a.download = url.split('/').pop() || 'image.png';
    a.click();
  }

  const t = result?.text;

  return (
    <div className="max-w-5xl mx-auto p-4 space-y-4">
      <div className="flex items-center gap-2">
        <span className="text-3xl">{props.icon}</span>
        <div>
          <h1 className="text-xl font-semibold">{props.title}</h1>
          <p className="text-xs text-slate-500">输入一句话主题，AI 一次性产出标题 + 文案 + 主图（{props.expectSize}）</p>
        </div>
      </div>

      <div className="card">
        <div className="card-body space-y-3">
          <textarea
            className="input min-h-[100px]"
            value={topic}
            onChange={(e) => setTopic(e.target.value)}
            placeholder={props.placeholder}
            disabled={loading}
          />
          <div className="flex items-center gap-2">
            <button onClick={generate} disabled={loading || !topic.trim()} className="btn-primary inline-flex items-center gap-1">
              {loading ? <><Loader2 className="animate-spin" size={14} /> {stage || '生成中...'}</> : '一键生成'}
            </button>
            {result && !loading && (
              <button onClick={generate} className="btn-secondary inline-flex items-center gap-1 text-sm">
                <RefreshCw size={14} /> 重新生成
              </button>
            )}
          </div>
          {error && <div className="text-sm text-red-600 bg-red-50 dark:bg-red-950/30 p-2 rounded">{error}</div>}
        </div>
      </div>

      {result && (result.text || result.image) && (
        <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
          {/* 文案 */}
          <div className="card">
            <div className="card-header flex items-center justify-between">
              <h2 className="font-semibold">📝 文案</h2>
              {t && <button onClick={copyAllText} className="text-xs btn-secondary inline-flex items-center gap-1"><Copy size={12} /> 复制全部</button>}
            </div>
            <div className="card-body space-y-3 text-sm">
              {t?.title && (
                <div>
                  <div className="text-xs text-slate-500 mb-1">标题</div>
                  <div className="font-medium">{t.title}</div>
                </div>
              )}
              {t?.body && (
                <div>
                  <div className="text-xs text-slate-500 mb-1">正文</div>
                  <div className="whitespace-pre-wrap leading-relaxed">{t.body}</div>
                </div>
              )}
              {Array.isArray(t?.sellingPoints) && t.sellingPoints.length > 0 && (
                <div>
                  <div className="text-xs text-slate-500 mb-1">卖点</div>
                  <ul className="list-disc list-inside space-y-1">
                    {t.sellingPoints.map((sp, i) => <li key={i}>{sp}</li>)}
                  </ul>
                </div>
              )}
              {Array.isArray(t?.tags) && t.tags.length > 0 && (
                <div>
                  <div className="text-xs text-slate-500 mb-1">标签</div>
                  <div className="flex flex-wrap gap-1">
                    {t.tags.map((tag, i) => (
                      <span key={i} className="text-xs px-2 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800">#{tag}</span>
                    ))}
                  </div>
                </div>
              )}
              {(t?.priceTag || t?.sellingPoint) && (
                <div className="flex gap-2 text-xs">
                  {t.priceTag && <span className="px-2 py-0.5 rounded bg-amber-100 dark:bg-amber-900/30 text-amber-800 dark:text-amber-200">{t.priceTag}</span>}
                  {t.sellingPoint && <span className="px-2 py-0.5 rounded bg-emerald-100 dark:bg-emerald-900/30 text-emerald-800 dark:text-emerald-200">{t.sellingPoint}</span>}
                </div>
              )}
              {t?.styleSummary && (
                <details className="text-xs text-slate-500">
                  <summary className="cursor-pointer">配图风格说明</summary>
                  <div className="mt-1 leading-relaxed">{t.styleSummary}</div>
                </details>
              )}
            </div>
          </div>

          {/* 图片 */}
          <div className="card">
            <div className="card-header flex items-center justify-between">
              <h2 className="font-semibold">🎨 主图</h2>
              {result.image?.url && <button onClick={downloadImage} className="text-xs btn-secondary inline-flex items-center gap-1"><Download size={12} /> 下载</button>}
            </div>
            <div className="card-body space-y-2">
              {result.image?.url ? (
                <>
                  {/* eslint-disable-next-line @next/next/no-img-element */}
                  <img src={result.image.url} alt="生成主图" className="w-full rounded border border-slate-200 dark:border-slate-700" />
                  <div className="text-[11px] text-slate-500 space-y-0.5">
                    {result.image.cropInfo && !result.image.cropInfo.error && (
                      <div>尺寸：{result.image.cropInfo.from} → {result.image.cropInfo.to}（已按平台规范裁剪）</div>
                    )}
                    {result.image.cropInfo?.error && (
                      <div className="text-amber-600">裁剪失败，显示原图：{result.image.cropInfo.error}</div>
                    )}
                    {result.timing && (
                      <div>用时：写文案 {Math.round(result.timing.llmMs / 100) / 10}s · 生图 {Math.round(result.timing.imgMs / 100) / 10}s · 裁剪 {Math.round(result.timing.cropMs / 100) / 10}s</div>
                    )}
                  </div>
                </>
              ) : (
                <div className="text-sm text-slate-400 text-center py-12">图片未生成</div>
              )}
            </div>
          </div>
        </div>
      )}
    </div>
  );
}
